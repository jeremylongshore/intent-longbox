# Beads task-tracking hook (Dolt<->git sync) — husky owns core.hooksPath, so chain it.
if [ -x .beads/hooks/pre-commit ]; then .beads/hooks/pre-commit "$@"; fi

pnpm lint-staged
pnpm typecheck && pnpm test
# Containment via in-repo audit-harness — never ~/.claude paths.
pnpm exec audit-harness escape-scan --staged
pnpm exec audit-harness verify
